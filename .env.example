# Firebase web config for accounts and sync. Copy to .env.local and fill in from
# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration.
#
# These are public values. Every web app that uses Firebase ships them in its bundle. Access is
# controlled by firestore.rules (each user reaches only their own document) and by the authorised
# domain list on the project, not by keeping these hidden.
#
# Leave the file out entirely and the app runs exactly as before: local only, no sign-in button.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
