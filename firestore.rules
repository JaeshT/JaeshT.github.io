rules_version = '2';

// One document per user, reachable only by that user. Paste this into
// Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Nothing else in the database is reachable from a client.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
